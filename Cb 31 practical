import java.util.Scanner;
import java.util.Locale;
import java.text.MessageFormat;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        scanner.useLocale(Locale.US);

        System.out.print("Введіть ціле число: ");
        int number = scanner.nextInt();

        System.out.print("Введіть число з плаваючою точкою: ");
        double decimal = scanner.nextDouble();

        System.out.print("Введіть строку: ");
        scanner.nextLine();
        String text = scanner.nextLine();

        System.out.print("Введіть логічне значення (true/false): ");
        boolean bool = scanner.nextBoolean();

        // 1. println
        System.out.println("\n1. println:");
        System.out.println(number);
        System.out.println(decimal);
        System.out.println(text);
        System.out.println(bool);

        // 2. MessageFormat
        System.out.println("\n2. MessageFormat:");
        System.out.println(MessageFormat.format(
                "Число: {0}, Дробове: {1}, Строка: {2}, Логічне: {3}",
                number, decimal, text, bool));

        System.out.println(MessageFormat.format(
                "Число: {0,number,integer}", number));

        System.out.println(MessageFormat.format(
                "Дробове число: {0,number}", decimal));

        // 3. System.out.format
        System.out.println("\n3. System.out.format:");

        System.out.format("Десяткове число: %d%n", number);
        System.out.format("Шістнадцяткове число: %x%n", number);
        System.out.format("Вісімкове число: %o%n", number);

        System.out.format("Дробове число: %.2f%n", decimal);
        System.out.format("Строка: %s%n", text);
        System.out.format("Строка з шириною поля: %15s%n", text);
        System.out.format("Логічне значення: %b%n", bool);

        scanner.close();
    }
}
